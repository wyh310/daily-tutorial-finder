# 复制本文件为 .env 并在本地测试时使用（.env 已被 .gitignore 忽略，不会上传）
# 部署到 GitHub Actions 时：
#   · 非敏感配置（DB_HOST/PORT/USER/NAME、NOTIFY、邮件地址、SMTP 地址端口）→ 配为仓库 Variables
#   · 敏感凭证（DB_PASS、SERVERCHAN_KEY、EMAIL_PASS）→ 配为仓库 Secrets
# 二者都在 仓库 Settings → Secrets and variables → Actions 里配置

# —— 通知渠道（NOTIFY）：wechat=仅微信 / email=仅邮件 / both=微信+邮件 / none=不推送仅本地 ——
NOTIFY=wechat

# —— 微信推送（Server酱，可选；不填则只本地生成简报）——
SERVERCHAN_KEY=

# —— 邮件推送（SMTP，可选；需 SMTP_HOST/EMAIL_FROM/EMAIL_PASS/EMAIL_TO 齐全才发送）——
SMTP_HOST=
SMTP_PORT=465
EMAIL_FROM=
EMAIL_PASS=
EMAIL_TO=

# —— 数据库（MySQL，按 URL 去重存储）——
DB_HOST=mysql6.sqlpub.com
DB_PORT=3311
DB_USER=yy_aggregator
DB_NAME=yy_aggregator
DB_PASS=
